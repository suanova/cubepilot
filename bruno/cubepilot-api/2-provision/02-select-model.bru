meta {
  name: select model + instructions
  type: http
  seq: 2
}

docs {
  # 选模型 + 写系统提示词

  **扁平 body**(与 GET 同一形状),字段名取自 CRD。

  `selectedModel` 必须是模板 `spec.models` 里有的,否则 400;
  传空串 = 「用运行时默认」(清掉覆盖)。

  旧形状 `{"config": {...}}` 现在返回 **400** —— 服务端开了
  `DisallowUnknownFields`,故意把「静默清空」变成可诊断的错误。

  没有实例时 → **409** `no agent instance yet`。
}

put {
  url: {{baseUrl}}/api/v1/agent/config
  body: json
  auth: none
}

headers {
  X-CubePilot-User: {{user}}
}

body:json {
  {
    "selectedModel": "{{llmName}}",
    "userInstructions": "回答用中文,尽量简洁。"
  }
}

tests {
  test("200", function() { expect(res.status).to.equal(200) })
  test("echoes the selection", function() {
    // 用 interpolate 而不是 getEnvVar：变量可能来自 collection.bru 的兜底
    // （No Environment 时），getEnvVar 只读环境作用域、会拿到 undefined。
    expect(res.body.selectedModel).to.equal(bru.interpolate("{{llmName}}"))
  })
}
