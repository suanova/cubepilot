meta {
  name: taskruns
  type: http
  seq: 9
}

docs {
  # 运行记录 / 巡检报告

  只读 —— 由 scheduler 以平台身份写入,API 从不创建 TaskRun。
  可加 `?task=<name>` 过滤单个任务。

  信封是 `taskruns`(**全小写**,和 `taskTemplates` 的驼峰不一样)。
}

get {
  url: {{baseUrl}}/api/v1/taskruns
  body: none
  auth: none
}

headers {
  X-CubePilot-User: {{user}}
}

tests {
  test("enveloped under taskruns", function() {
    expect(res.body).to.have.property("taskruns")
  })
}
