meta {
  name: approval pending
  type: http
  seq: 5
}

docs {
  # 找回未决审批

  刷新页面后恢复确认卡片用 —— **必需,不是可选**。

  一次返回该会话**所有**未决审批(一个回合可以同时压着多条),按
  `createdAtMs` 从旧到新:

  ```
  200 {"approvals":[{"sessionId":"agent:main:conv-...","approvalId":"...","tool":"exec",
                     "command":"...","level":"write","createdAtMs":1758...,"expiresAtMs":1758...}]}
  ```

  **没有未决项是 `200 {"approvals":[]}`**,不是 404 —— 集合存在,只是空的。空数组
  **是**正常的"没有未决项",静默忽略。

  `502` 是**读不到网关**,不能当成"没有未决项":可能有一张卡你看不见。
}

get {
  url: {{baseUrl}}/api/v1/sessions/{{sessionId}}/approvals
  body: none
  auth: none
}

headers {
  X-CubePilot-User: {{user}}
}

tests {
  test("200, with an empty list when nothing is pending", function() {
    expect(res.status).to.equal(200)
    const body = typeof res.body === "string" ? JSON.parse(res.body) : res.body
    expect(body.approvals).to.be.an("array")
  })
  test("each entry names its approval", function() {
    const body = typeof res.body === "string" ? JSON.parse(res.body) : res.body
    body.approvals.forEach((a) => expect(a.approvalId).to.be.a("string").and.not.empty)
  })
}
