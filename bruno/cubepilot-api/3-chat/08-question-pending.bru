meta {
  name: question pending
  type: http
  seq: 8
}

docs {
  # 找回未决问答

  刷新页面后恢复问题卡片用，和 `05-approval-pending` 同理。

  ⚠️ 两个 id **不是一回事**：
  - `questions[].id`（外层）是**问答记录 id** —— 回答/取消时用这个当 `id`
  - `questions[].questions[].questionId` 是**每个问题的 id** —— 答案 map 的键

  内层字段名是复数 `questions`，别取错层。

  **没有未决项是 `200 {"questions":[]}`**，不是 404 —— 集合存在，只是空的。空数组
  **是**正常的"没有未决项"，静默忽略。

  `502` 是**读不到网关**，不能当成"没有未决项"。
}

get {
  url: {{baseUrl}}/api/v1/sessions/{{sessionId}}/questions
  body: none
  auth: none
}

headers {
  X-CubePilot-User: {{user}}
}

tests {
  test("200, with an empty list when nothing is pending", function() {
    expect(res.status).to.equal(200)
    const body = typeof res.body === "string" ? JSON.parse(res.body) : res.body
    expect(body.questions).to.be.an("array")
  })
}
